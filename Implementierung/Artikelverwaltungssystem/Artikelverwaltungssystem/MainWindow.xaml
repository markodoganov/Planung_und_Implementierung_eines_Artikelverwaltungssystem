<Window x:Class="Artikelverwaltungssystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Artikelverwaltungssystem"
        Height="650"
        Width="1200">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Artikelverwaltungssystem"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Verwaltung von Inventarartikeln"
                       FontSize="14"
                       Foreground="Gray"/>
        </StackPanel>

        <GroupBox Header="Artikel suchen"
                  Grid.Row="1"
                  Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal" Margin="10">

                <TextBox Name="txtSuche"
                         Width="300"
                         Height="30"
                         TextChanged="TxtSuche_TextChanged"/>

            </StackPanel>

        </GroupBox>

        <GroupBox Header="Artikel anlegen / bearbeiten"
                  Grid.Row="2"
                  Margin="0,0,0,15">

            <StackPanel Margin="10">

                <WrapPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Bezeichnung"/>
                        <TextBox Name="txtBezeichnung" Width="140"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Kategorie"/>
                        <TextBox Name="txtKategorie" Width="120"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Inventarnummer"/>
                        <TextBox Name="txtInventarnummer" Width="140"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Seriennummer"/>
                        <TextBox Name="txtSeriennummer" Width="140"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Status"/>
                        <TextBox Name="txtStatus" Width="120"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Abteilung"/>
                        <ComboBox Name="cmbAbteilung"
                                  Width="140"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="AbteilungsID"/>
                    </StackPanel>

                    <StackPanel Margin="5"
                                VerticalAlignment="Bottom">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,20,0,0">

                            <Button Content="Artikel speichern"
                                    Width="150"
                                    Height="30"
                                    Margin="0,0,10,0"
                                    Click="BtnArtikelSpeichern_Click"/>

                            <Button Content="Artikel aktualisieren"
                                    Width="150"
                                    Height="30"
                                    Click="BtnArtikelAktualisieren_Click"/>

                        </StackPanel>

                    </StackPanel>

                </WrapPanel>

            </StackPanel>

        </GroupBox>

        <DataGrid Name="dgArtikel"
                  ItemsSource="{Binding ArtikelListe}"
                  SelectionChanged="dgArtikel_SelectionChanged"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Bezeichnung"
                                    Binding="{Binding Bezeichnung}"
                                    Width="*"/>

                <DataGridTextColumn Header="Kategorie"
                                    Binding="{Binding Kategorie}"
                                    Width="*"/>

                <DataGridTextColumn Header="Inventarnummer"
                                    Binding="{Binding Inventarnummer}"
                                    Width="*"/>

                <DataGridTextColumn Header="Seriennummer"
                                    Binding="{Binding Seriennummer}"
                                    Width="*"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="*"/>

                <DataGridTextColumn Header="Abteilung"
                    Binding="{Binding AbteilungsID}"
                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button Content="Verbrauch buchen"
            Width="180"
            Height="35"
            Margin="0,0,10,0"
            Click="BtnVerbrauch_Click"/>

            <Button Content="Historie anzeigen"
            Width="180"
            Height="35"
            Margin="0,0,10,0"
            Click="BtnHistorie_Click"/>

            <Button Content="Ausgewählten Artikel löschen"
            Width="220"
            Height="35"
            Click="BtnLoeschen_Click"/>

        </StackPanel>

    </Grid>

</Window>